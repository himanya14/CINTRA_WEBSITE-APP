# COPY THESE TWO VALUES FROM YOUR ORIGINAL WORKING CINTRA WEBSITE backend/.env
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cintra_db
CINTRA_SECRET_KEY=PASTE_THE_WEBSITE_SECRET_KEY_HERE
CINTRA_ACCESS_TOKEN_MINUTES=240

# AES-256-GCM evidence encryption.
# Recommended: generate an independent 32-byte key and paste its urlsafe Base64 value.
# PowerShell generation command is documented in README_RUN.md.
# If omitted for a local demo, the backend derives a stable 32-byte key from CINTRA_SECRET_KEY.
CINTRA_EVIDENCE_ENCRYPTION_KEY=

# Optional Hyperledger Fabric Gateway integration.
# Keep false unless your Node Fabric Gateway is actually running on port 4100.
FABRIC_ENABLED=false
FABRIC_GATEWAY_URL=http://127.0.0.1:4100
FABRIC_GATEWAY_TIMEOUT_SECONDS=8
